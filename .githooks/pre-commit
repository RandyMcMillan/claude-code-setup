#!/usr/bin/env bash
set -euo pipefail

FILES=()
while IFS= read -r file; do
  if [[ "$file" == skills/* && "$file" == */templates/* ]]; then
    continue
  fi
  case "$file" in
    *.md) FILES+=("$file") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#FILES[@]} -eq 0 ]; then
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "pre-commit markdown lint skipped: npx not found (install Node.js to enable markdown linting)" >&2
  exit 0
fi

npx --yes markdownlint-cli2 "${FILES[@]}"
